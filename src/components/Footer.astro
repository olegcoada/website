---
import { site } from '@/site.config';
const socials = [
  ['X', site.social.x], ['LinkedIn', site.social.linkedin], ['Dribbble', site.social.dribbble], ['Behance', site.social.behance],
] as const;
---

<footer class="footer">
  <div class="container">
    <p class="label">Start a project</p>
    <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="row">
      <p class="lede">Fill in the short form and I reply within 24 hours with initial thoughts.</p>
      <a class="btn btn--light" href={site.cta.href}><span class="dot" aria-hidden="true"></span>{site.cta.label}</a>
    </div>
    <div class="base">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <ul>{socials.map(([n, h]) => <li><a href={h} rel="me noopener" target="_blank">{n}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-ink-panel); color: var(--color-text-inverse); padding-top: var(--space-24); padding-bottom: var(--space-8); }
  .footer .label { color: var(--color-text-inverse-muted); }
  .mail { display: block; margin-top: var(--space-6); font-size: clamp(2rem, 0.6rem + 6.4vw, 7rem); letter-spacing: var(--tracking-tighter); line-height: 1; text-decoration: none; overflow-wrap: anywhere; }
  .mail:hover { color: var(--color-accent); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-6); margin-top: var(--space-12); padding-bottom: var(--space-24); }
  .lede { color: var(--color-text-inverse-muted); max-width: 36ch; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--color-border-inverse); font-size: var(--text-sm); color: var(--color-text-inverse-muted); }
  .base ul { display: flex; gap: var(--space-6); list-style: none; padding: 0; }
  .base a { text-decoration: none; }
  .base a:hover { color: var(--color-text-inverse); }
</style>
