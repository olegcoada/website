---
// Home page: offer-led, proof-heavy. Sections read top to bottom:
// promise → proof (work, logos, track record) → offer → how to start → about → FAQ → contact.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import LogoWall from '@/components/LogoWall.astro';
import Work from '@/components/Work.astro';
import TrackRecord from '@/components/TrackRecord.astro';
import Offer from '@/components/Offer.astro';
import Process from '@/components/Process.astro';
import About from '@/components/About.astro';
import Faq from '@/components/Faq.astro';
import Footer from '@/components/Footer.astro';
import { getEntry } from 'astro:content';
import { getFeaturedProjects, getServices, getClients, getLogos, getFaq } from '@/lib/content';

const [projects, services, clients, logos, faq] = await Promise.all([
  getFeaturedProjects(), getServices(), getClients(), getLogos(), getFaq(),
]);
const offer = (await getEntry('pages', 'offer'))!;
const about = (await getEntry('pages', 'about'))!;
---

<BaseLayout>
  <Header slot="header" />
  <Hero projects={projects} />
  <LogoWall logos={logos} />
  <Work projects={projects} />
  <TrackRecord clients={clients} />
  <Offer service={services[0]!} intro={offer} />
  <Process offer={offer} />
  <About about={about} />
  <Faq faq={faq} />
  <Footer slot="footer" />
</BaseLayout>
